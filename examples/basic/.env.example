# .env 로 복사한 뒤 필요에 맞게 수정하세요. 모두 표준 OpenTelemetry 변수입니다.
# Copy to .env and adjust. Every variable here is a standard OpenTelemetry one.
OTEL_SERVICE_NAME=otel-kit-example-basic
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local,service.version=0.0.1

# collector 출력에서 metric을 빨리 보기 위해 5초마다 내보냅니다 (기본 60초)
# Export metrics every 5s so you see them quickly in the collector output (default 60s)
OTEL_METRIC_EXPORT_INTERVAL=5000

# 특정 신호를 끄려면 주석을 해제하세요
# Uncomment to silence a signal
# OTEL_LOGS_EXPORTER=none
# OTEL_METRICS_EXPORTER=none

# 로컬 collector 대신 SigNoz Cloud를 쓸 때
# SigNoz Cloud instead of the local collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-key>
